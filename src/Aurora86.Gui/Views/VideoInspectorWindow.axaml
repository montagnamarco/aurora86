<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aurora86.Gui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="Aurora86.Gui.Views.VideoInspectorWindow"
        x:DataType="vm:VideoInspectorViewModel"
        Width="1100" Height="720"
        Background="#1E1E1E"
        Title="Aurora86 — Video memory">

  <Window.Styles>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Menlo,Consolas,monospace" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#D4D4D4" />
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="Foreground" Value="#9CDCFE" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="Foreground" Value="#808080" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#E0E0E0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#333333" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#252526" />
      <Setter Property="BorderBrush" Value="#3A3A3A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="3" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- What the card is doing, in one line each. -->
    <Border DockPanel.Dock="Top" Classes="panel">
      <StackPanel Spacing="3">
        <TextBlock Classes="mono" Foreground="#CE9178" Text="{Binding Mode}" />
        <TextBlock Classes="mono" Text="{Binding Geometry}" />
        <TextBlock Classes="mono" Text="{Binding MemoryLayout}" />
        <TextBlock Classes="mono" Foreground="#808080" Text="{Binding Apertures}" />
      </StackPanel>
    </Border>

    <!-- Where to look, and how to read what is there. -->
    <Border DockPanel.Dock="Top" Classes="panel">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Classes="tool" Content="Refresh" Command="{Binding RefreshCommand}" />
        <Border Width="1" Background="#3A3A3A" Margin="4,2" />

        <Button Classes="tool" Content="Display start"
                Command="{Binding ShowDisplayStartCommand}"
                ToolTip.Tip="Where the monitor reads from, which is not always where a driver wrote" />
        <Button Classes="tool" Content="A0000 window" Command="{Binding ShowLegacyWindowCommand}" />
        <Button Classes="tool" Content="B8000 text" Command="{Binding ShowTextWindowCommand}" />
        <Border Width="1" Background="#3A3A3A" Margin="4,2" />

        <Button Classes="tool" Content="⇱" Command="{Binding HomeCommand}" ToolTip.Tip="Back to offset zero" />
        <Button Classes="tool" Content="▲" Command="{Binding PageUpCommand}" />
        <Button Classes="tool" Content="▼" Command="{Binding PageDownCommand}" />
        <Border Width="1" Background="#3A3A3A" Margin="4,2" />

        <TextBlock Classes="mono" VerticalAlignment="Center" Text="offset" />
        <TextBox Width="90" FontFamily="Menlo,Consolas,monospace" FontSize="11"
                 Text="{Binding ViewOffset}" />

        <TextBlock Classes="mono" VerticalAlignment="Center" Text="stride" />
        <TextBox Width="70" FontFamily="Menlo,Consolas,monospace" FontSize="11"
                 Text="{Binding ViewStride}"
                 ToolTip.Tip="Bytes per row. A picture drawn with the wrong stride shears diagonally, so being able to try another value is how the right one is found." />

        <ComboBox Width="150" SelectedItem="{Binding ViewKind}" FontSize="11"
                  ItemsSource="{Binding Source={x:Static vm:VideoInspectorViewModel.ViewKinds}}" />

        <Border Width="1" Background="#3A3A3A" Margin="4,2" />
        <Button Classes="tool" Content="−" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Smaller (− or ctrl-wheel)" />
        <TextBlock Classes="mono" VerticalAlignment="Center" MinWidth="34"
                   TextAlignment="Center" Text="{Binding Zoom, StringFormat='×{0}'}" />
        <Button Classes="tool" Content="+" Command="{Binding ZoomInCommand}" ToolTip.Tip="Larger (+ or ctrl-wheel)" />
        <Button Classes="tool" Content="1:1" Command="{Binding ZoomResetCommand}" ToolTip.Tip="Back to one byte per pixel (0)" />
      </StackPanel>
    </Border>

    <TextBlock DockPanel.Dock="Bottom" Classes="note" Margin="10,4"
               Text="{Binding ViewDescription}" />

    <Grid ColumnDefinitions="*,340">

      <!-- The memory, drawn. -->
      <Border Grid.Column="0" Classes="panel">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Image Name="MemoryView" Stretch="None" RenderOptions.BitmapInterpolationMode="None"
                 HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>
      </Border>

      <!-- Registers and palette. -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>

          <Border Classes="panel">
            <StackPanel>
              <TextBlock Classes="header" Text="PALETTE" />
              <ItemsControl ItemsSource="{Binding Palette}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="18" Height="14" Margin="1"
                            Background="{Binding Colour}"
                            BorderBrush="#3A3A3A" BorderThickness="1"
                            ToolTip.Tip="{Binding Tooltip}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding Registers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="panel">
                  <StackPanel>
                    <TextBlock Classes="header" Text="{Binding Name}" />
                    <TextBlock Classes="mono" Text="{Binding Values}" />
                    <TextBlock Classes="note" TextWrapping="Wrap" Text="{Binding Note}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
