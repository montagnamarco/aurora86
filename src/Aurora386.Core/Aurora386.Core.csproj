<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- L'accesso alla RAM emulata avviene via puntatori: evita bounds-check
         su ogni singola lettura/scrittura di memoria nel loop caldo. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- PGO a livelli: il dispatch degli opcode e' un branch altamente
         polimorfo, la profilazione a runtime lo migliora sensibilmente. -->
    <TieredPGO>true</TieredPGO>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- I test parlano ai formati dei pacchetti del NAT, che restano un
         dettaglio interno per tutti gli altri. -->
    <InternalsVisibleTo Include="Aurora386.Tests" />
  </ItemGroup>

</Project>
