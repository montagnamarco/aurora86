<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aurora386.Gui.ViewModels"
        xmlns:ctl="using:Aurora386.Gui.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="Aurora386.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="900" Height="700"
        RequestedThemeVariant="Dark"
        Background="#1E1E1E"
        Title="{Binding WindowTitle}">

  <Window.Styles>
    <!-- The status bar lights. A real drive LED is dark until the head
         moves, so the resting state is a dim outline and activity fills it
         in; that reads at a glance without being distracting. -->
    <Style Selector="Ellipse.led">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="Fill" Value="#2A2A2A" />
      <Setter Property="Stroke" Value="#454545" />
      <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style Selector="Ellipse.led.on">
      <Setter Property="Fill" Value="#4CD964" />
      <Setter Property="Stroke" Value="#3AA94C" />
    </Style>
    <Style Selector="Ellipse.led.power.on">
      <Setter Property="Fill" Value="#4C9AFF" />
      <Setter Property="Stroke" Value="#3A78CC" />
    </Style>
    <Style Selector="Ellipse.led.activity.on">
      <Setter Property="Fill" Value="#FFB340" />
      <Setter Property="Stroke" Value="#CC8A2E" />
    </Style>

    <!-- Toolbar buttons: a square icon with its full name underneath.
         Fixed width, so the labels sit on a regular grid and none of them
         has to be shortened to an ellipsis. -->
    <Style Selector="Button.tool, ToggleButton.tool">
      <Setter Property="Width" Value="62" />
      <Setter Property="Height" Value="52" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#E0E0E0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter,
                     ToggleButton.tool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#333333" />
    </Style>
    <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#3A5A8C" />
    </Style>
    <Style Selector="Button.tool:disabled, ToggleButton.tool:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>

    <!-- The icons are stroked outlines rather than filled shapes: at this
         size a filled glyph turns into a blob, while an outline keeps its
         silhouette. They inherit no colour from the button, so the label
         and the icon are tinted separately. -->
    <Style Selector="Path.icon">
      <Setter Property="Stroke" Value="#D8D8D8" />
      <Setter Property="StrokeThickness" Value="1.4" />
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Path.icon.filled">
      <Setter Property="Fill" Value="#D8D8D8" />
    </Style>

    <Style Selector="TextBlock.toollabel">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="Foreground" Value="#C8C8C8" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style Selector="TextBlock.status">
      <Setter Property="Foreground" Value="#B0B0B0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.status.captured">
      <Setter Property="Foreground" Value="#FFB340" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Separator.vertical">
      <Setter Property="Width" Value="1" />
      <Setter Property="Margin" Value="6,4" />
      <Setter Property="Background" Value="#3A3A3A" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <Menu DockPanel.Dock="Top" Name="MainMenu">
      <MenuItem Header="_File">
        <MenuItem Header="_Open virtual machine…" Command="{Binding OpenVmCommand}" />
        <MenuItem Header="_Save virtual machine…" Command="{Binding SaveVmCommand}" />
        <Separator />
        <MenuItem Header="Create disk image…" Command="{Binding CreateDiskCommand}" />
      </MenuItem>
      <MenuItem Header="_Virtual Machine">
        <MenuItem Header="_Start" Command="{Binding StartCommand}" />
        <MenuItem Header="_Pause / Resume" Command="{Binding TogglePauseCommand}" />
        <MenuItem Header="_Reset" Command="{Binding ResetCommand}" />
        <MenuItem Header="Turbo" ToggleType="CheckBox" IsChecked="{Binding Turbo, Mode=OneWay}" Command="{Binding ToggleTurboCommand}" />
        <Separator />
        <MenuItem Header="Save snapshot…" Command="{Binding SaveStateCommand}" />
        <MenuItem Header="Restore snapshot…" Command="{Binding RestoreStateCommand}" />
        <MenuItem Header="Processor (next reset)">
          <MenuItem Header="486DX" ToggleType="Radio" IsChecked="{Binding CpuIs486, Mode=TwoWay}" />
          <MenuItem Header="386DX" ToggleType="Radio" IsChecked="{Binding CpuIs386, Mode=TwoWay}" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Full screen / Windowed" Click="ToggleFullScreen" />
        <MenuItem Header="Save screenshot…" Command="{Binding ScreenshotCommand}" />
        <MenuItem Header="Video inspector…" Command="{Binding OpenVideoInspectorCommand}" />
      </MenuItem>
      <MenuItem Header="_Devices">
        <MenuItem Header="Floppy A:">
          <MenuItem Header="Insert image…" Command="{Binding MountFloppyACommand}" />
          <MenuItem Header="Eject" Command="{Binding EjectFloppyACommand}" />
        </MenuItem>
        <MenuItem Header="Floppy B:">
          <MenuItem Header="Insert image…" Command="{Binding MountFloppyBCommand}" />
          <MenuItem Header="Eject" Command="{Binding EjectFloppyBCommand}" />
        </MenuItem>
        <MenuItem Header="Hard disk image…" Command="{Binding MountHardDiskCommand}" />
        <MenuItem Header="CD-ROM">
          <MenuItem Header="Insert ISO…" Command="{Binding MountCompactDiscCommand}" />
          <MenuItem Header="Eject" Command="{Binding EjectCompactDiscCommand}" />
        </MenuItem>
        <MenuItem Header="USB storage">
          <MenuItem Header="Insert image…" Command="{Binding MountUsbStorageCommand}" />
          <MenuItem Header="Insert read-only image…" Command="{Binding MountUsbStorageCommand}" CommandParameter="readonly" />
          <MenuItem Header="Eject" Command="{Binding EjectUsbStorageCommand}" />
        </MenuItem>
        <MenuItem Header="Share host folder…" Command="{Binding ShareFolderCommand}" />
        <Separator />
        <MenuItem Header="Mouse">
          <MenuItem Header="PS/2" ToggleType="Radio" IsChecked="{Binding MouseIsPs2, Mode=TwoWay}" />
          <MenuItem Header="Serial (COM1)" ToggleType="Radio" IsChecked="{Binding MouseIsSerial, Mode=TwoWay}" />
          <MenuItem Header="Disconnected" ToggleType="Radio" IsChecked="{Binding MouseIsDisconnected, Mode=TwoWay}" />
        </MenuItem>
        <MenuItem Header="Network">
          <MenuItem Header="NAT" ToggleType="Radio" IsChecked="{Binding NetworkIsNat, Mode=TwoWay}" />
          <MenuItem Header="Disconnected" ToggleType="Radio" IsChecked="{Binding NetworkIsOff, Mode=TwoWay}" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Debug">
        <MenuItem Header="Open debugger…" Command="{Binding OpenDebuggerCommand}" />
        <MenuItem Header="Step instruction" Command="{Binding StepInstructionCommand}" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Background="#252525"
            BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
      <StackPanel Name="MainToolbar" Orientation="Horizontal" Margin="4,3">
        <Button Classes="tool" Command="{Binding StartCommand}"
                ToolTip.Tip="Power on the machine">
          <StackPanel>
            <Path Classes="icon" Data="M 12,3 L 12,11 M 6.5,6 A 8,8 0 1 0 17.5,6" />
            <TextBlock Classes="toollabel" Text="Start" />
          </StackPanel>
        </Button>

        <Button Classes="tool" Command="{Binding TogglePauseCommand}"
                ToolTip.Tip="Pause or resume emulation">
          <StackPanel>
            <Path Classes="icon filled" Data="M 8,5 L 11,5 L 11,19 L 8,19 Z M 14,5 L 17,5 L 17,19 L 14,19 Z" />
            <TextBlock Classes="toollabel" Text="Pause" />
          </StackPanel>
        </Button>

        <Button Classes="tool" Command="{Binding ResetCommand}"
                ToolTip.Tip="Cold reset: rebuild the machine and re-insert media">
          <StackPanel>
            <Path Classes="icon" Data="M 20,12 A 8,8 0 1 1 17,5.9 M 20,3 L 20,7 L 16,7" />
            <TextBlock Classes="toollabel" Text="Reset" />
          </StackPanel>
        </Button>

        <Button Classes="tool" Command="{Binding SaveStateCommand}"
                ToolTip.Tip="Save a runtime snapshot. Keep matching disk images to restore it.">
          <StackPanel>
            <Path Classes="icon" Data="M 3,8 L 8,8 L 10,5 L 14,5 L 16,8 L 21,8 L 21,20 L 3,20 Z M 12,10 A 4,4 0 1 0 12,18 A 4,4 0 1 0 12,10" />
            <TextBlock Classes="toollabel" Text="Save state" />
          </StackPanel>
        </Button>

        <Button Classes="tool" Command="{Binding RestoreStateCommand}"
                ToolTip.Tip="Restore runtime state using matching disk images">
          <StackPanel>
            <Path Classes="icon" Data="M 4,12 A 8,8 0 1 1 12,20 M 4,12 L 4,7 M 4,12 L 9,12 M 12,8 L 12,12 L 15,14" />
            <TextBlock Classes="toollabel" Text="Restore" />
          </StackPanel>
        </Button>
        <Button Classes="tool" Click="ToggleFullScreen" ToolTip.Tip="Toggle full screen">
          <StackPanel>
            <Path Classes="icon" Data="M 3,9 L 3,3 L 9,3 M 15,3 L 21,3 L 21,9 M 21,15 L 21,21 L 15,21 M 9,21 L 3,21 L 3,15" />
            <TextBlock Classes="toollabel" Text="Full screen" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <!-- ==================== status bar ==================== -->
    <Border DockPanel.Dock="Bottom" Background="#252525"
            BorderBrush="#3A3A3A" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="8,4">

        <!-- power -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5"
                    VerticalAlignment="Center">
          <Ellipse Classes="led power"
                   Classes.on="{Binding PowerLedOn}" />
          <TextBlock Classes="status" Text="Power" />
        </StackPanel>

        <Separator Grid.Column="1" Classes="vertical" />

        <!-- one light per attached drive -->
        <ItemsControl Grid.Column="2" ItemsSource="{Binding Drives}"
                      VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="14" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DriveIndicator">
              <StackPanel Orientation="Horizontal" Spacing="5"
                          VerticalAlignment="Center"
                          ToolTip.Tip="{Binding MediaName}">
                <Ellipse Classes="led activity"
                         Classes.on="{Binding IsActive}" />
                <TextBlock Classes="status" Text="{Binding Label}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- speed and message -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                      ToolTip.Tip="Network activity">
            <Ellipse Classes="led activity" Classes.on="{Binding NetworkLedOn}" />
            <TextBlock Classes="status" Text="NET" />
          </StackPanel>
          <!-- Shown only while the guest has the pointer. It is the only
               thing on screen that explains where the cursor went, so it is
               tinted rather than left to blend into the other messages. -->
          <TextBlock Classes="status captured"
                     Text="{Binding MouseCaptureText}"
                     IsVisible="{Binding MouseCaptured}" />
          <TextBlock Classes="status" Text="{Binding SpeedText}" />
          <TextBlock Classes="status" Text="{Binding StatusText}" />
        </StackPanel>

      </Grid>
    </Border>

    <!-- ==================== the emulated screen ==================== -->
    <!-- The control letterboxes the picture to 4:3 itself, so it can simply
         fill whatever space is left between the toolbar and the status bar. -->
    <ctl:ScreenView Name="Screen" Session="{Binding Session}" />

  </DockPanel>
</Window>
