<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aurora386.Gui.ViewModels"
        xmlns:ctl="using:Aurora386.Gui.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="Aurora386.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="900" Height="700"
        Background="#1E1E1E"
        Title="{Binding WindowTitle}">

  <Window.Styles>
    <!-- The status bar lights. A real drive LED is dark until the head
         moves, so the resting state is a dim outline and activity fills it
         in; that reads at a glance without being distracting. -->
    <Style Selector="Ellipse.led">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="Fill" Value="#2A2A2A" />
      <Setter Property="Stroke" Value="#454545" />
      <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style Selector="Ellipse.led.on">
      <Setter Property="Fill" Value="#4CD964" />
      <Setter Property="Stroke" Value="#3AA94C" />
    </Style>
    <Style Selector="Ellipse.led.power.on">
      <Setter Property="Fill" Value="#4C9AFF" />
      <Setter Property="Stroke" Value="#3A78CC" />
    </Style>
    <Style Selector="Ellipse.led.activity.on">
      <Setter Property="Fill" Value="#FFB340" />
      <Setter Property="Stroke" Value="#CC8A2E" />
    </Style>

    <!-- Toolbar buttons: a square icon with its full name underneath.
         Fixed width, so the labels sit on a regular grid and none of them
         has to be shortened to an ellipsis. -->
    <Style Selector="Button.tool, ToggleButton.tool">
      <Setter Property="Width" Value="62" />
      <Setter Property="Height" Value="52" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#E0E0E0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter,
                     ToggleButton.tool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#333333" />
    </Style>
    <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#3A5A8C" />
    </Style>
    <Style Selector="Button.tool:disabled, ToggleButton.tool:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>

    <!-- The icons are stroked outlines rather than filled shapes: at this
         size a filled glyph turns into a blob, while an outline keeps its
         silhouette. They inherit no colour from the button, so the label
         and the icon are tinted separately. -->
    <Style Selector="Path.icon">
      <Setter Property="Stroke" Value="#D8D8D8" />
      <Setter Property="StrokeThickness" Value="1.4" />
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Path.icon.filled">
      <Setter Property="Fill" Value="#D8D8D8" />
    </Style>

    <Style Selector="TextBlock.toollabel">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="Foreground" Value="#C8C8C8" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style Selector="TextBlock.status">
      <Setter Property="Foreground" Value="#B0B0B0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.status.captured">
      <Setter Property="Foreground" Value="#FFB340" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Separator.vertical">
      <Setter Property="Width" Value="1" />
      <Setter Property="Margin" Value="6,4" />
      <Setter Property="Background" Value="#3A3A3A" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- ==================== toolbar ==================== -->
    <Border DockPanel.Dock="Top" Background="#252525"
            BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Margin="4,3">

        <!-- Power: the IEC symbol, a broken ring with an upright bar. -->
        <Button Classes="tool" Command="{Binding StartCommand}"
                ToolTip.Tip="Power on the machine">
          <StackPanel>
            <Path Classes="icon" Data="M 12,3 L 12,11 M 6.5,6 A 8,8 0 1 0 17.5,6" />
            <TextBlock Classes="toollabel" Text="Start" />
          </StackPanel>
        </Button>

        <Button Classes="tool" Command="{Binding TogglePauseCommand}"
                ToolTip.Tip="Pause or resume emulation">
          <StackPanel>
            <Path Classes="icon filled" Data="M 8,5 L 11,5 L 11,19 L 8,19 Z M 14,5 L 17,5 L 17,19 L 14,19 Z" />
            <TextBlock Classes="toollabel" Text="Pause" />
          </StackPanel>
        </Button>

        <!-- Reset: an arrow chasing its own tail. -->
        <Button Classes="tool" Command="{Binding ResetCommand}"
                ToolTip.Tip="Cold reset: rebuild the machine and re-insert media">
          <StackPanel>
            <Path Classes="icon" Data="M 20,12 A 8,8 0 1 1 17,5.9 M 20,3 L 20,7 L 16,7" />
            <TextBlock Classes="toollabel" Text="Reset" />
          </StackPanel>
        </Button>

        <ToggleButton Classes="tool" IsChecked="{Binding Turbo}"
                Command="{Binding ToggleTurboCommand}"
                ToolTip.Tip="Run as fast as the host allows. Key repeat and anything else the guest times will run fast too.">
          <StackPanel>
            <Path Classes="icon filled" Data="M 13,2 L 5,13 L 11,13 L 10,22 L 18,10 L 12,10 Z" />
            <TextBlock Classes="toollabel" Text="Turbo" />
          </StackPanel>
        </ToggleButton>

        <Separator Classes="vertical" />

        <!-- A 3.5-inch diskette: the shutter across the top, the label below. -->
        <Button Classes="tool" Command="{Binding MountFloppyACommand}"
                ToolTip.Tip="Insert a floppy image into drive A:">
          <StackPanel>
            <Path Classes="icon" Data="M 4,4 L 16,4 L 20,8 L 20,20 L 4,20 Z M 8,4 L 8,10 L 16,10 L 16,4 M 7,14 L 17,14 L 17,20 L 7,20 Z" />
            <TextBlock Classes="toollabel" Text="Floppy A" />
          </StackPanel>
        </Button>

        <Button Classes="tool" Command="{Binding MountFloppyBCommand}"
                ToolTip.Tip="Insert a floppy image into drive B:">
          <StackPanel>
            <Path Classes="icon" Data="M 4,4 L 16,4 L 20,8 L 20,20 L 4,20 Z M 8,4 L 8,10 L 16,10 L 16,4 M 7,14 L 17,14 L 17,20 L 7,20 Z" />
            <TextBlock Classes="toollabel" Text="Floppy B" />
          </StackPanel>
        </Button>

        <!-- A stack of platters, drawn the way disks have been drawn since
             the days when they really were a stack of platters. -->
        <Button Classes="tool" Command="{Binding MountHardDiskCommand}"
                ToolTip.Tip="Attach a hard disk image (up to four)">
          <StackPanel>
            <Path Classes="icon" Data="M 3,6 A 9,3 0 1 0 21,6 A 9,3 0 1 0 3,6 M 3,6 L 3,18 A 9,3 0 0 0 21,18 L 21,6 M 3,12 A 9,3 0 0 0 21,12" />
            <TextBlock Classes="toollabel" Text="Hard disk" />
          </StackPanel>
        </Button>

        <Button Classes="tool" Command="{Binding MountCompactDiscCommand}"
                ToolTip.Tip="Insert a CD-ROM image (ISO 9660)">
          <StackPanel>
            <Path Classes="icon" Data="M 12,3 A 9,9 0 1 1 11.99,3 Z M 12,10 A 2,2 0 1 1 11.99,10 Z" />
            <TextBlock Classes="toollabel" Text="CD-ROM" />
          </StackPanel>
        </Button>

        <!-- A folder shared with the guest: the folder with an arrow going
             into it. -->
        <Button Classes="tool" Command="{Binding ShareFolderCommand}"
                ToolTip.Tip="Share a folder of this computer with the guest, as drive E:">
          <StackPanel>
            <Path Classes="icon" Data="M 3,6 L 9,6 L 11,9 L 21,9 L 21,19 L 3,19 Z M 12,11 L 12,17 M 9,14 L 12,17 L 15,14" />
            <TextBlock Classes="toollabel" Text="Share" />
          </StackPanel>
        </Button>

        <!-- A machine folder: a box with its lid, opening and closing. -->
        <Button Classes="tool" Command="{Binding OpenVmCommand}"
                ToolTip.Tip="Open a machine from its folder (one with vm.json in it)">
          <StackPanel>
            <Path Classes="icon" Data="M 3,9 L 12,5 L 21,9 L 21,19 L 12,23 L 3,19 Z M 3,9 L 12,13 L 21,9 M 12,13 L 12,23" />
            <TextBlock Classes="toollabel" Text="Open VM" />
          </StackPanel>
        </Button>
        <Button Classes="tool" Command="{Binding SaveVmCommand}"
                ToolTip.Tip="Save this machine -- drives, mouse, processor, boot order -- to its folder">
          <StackPanel>
            <Path Classes="icon" Data="M 4,4 L 17,4 L 21,8 L 21,21 L 4,21 Z M 7,4 L 7,10 L 15,10 L 15,4 M 7,21 L 7,15 L 18,15 L 18,21" />
            <TextBlock Classes="toollabel" Text="Save VM" />
          </StackPanel>
        </Button>

        <!-- A saved state: the machine frozen, a camera. -->
        <Button Classes="tool" Command="{Binding SaveStateCommand}"
                ToolTip.Tip="Save the whole state of the machine -- memory, processor, devices, screen -- to come back to in an instant">
          <StackPanel>
            <Path Classes="icon" Data="M 3,8 L 8,8 L 10,5 L 14,5 L 16,8 L 21,8 L 21,20 L 3,20 Z M 12,10 A 4,4 0 1 0 12,18 A 4,4 0 1 0 12,10" />
            <TextBlock Classes="toollabel" Text="Save state" />
          </StackPanel>
        </Button>
        <Button Classes="tool" Command="{Binding RestoreStateCommand}"
                ToolTip.Tip="Put a saved state back into the machine">
          <StackPanel>
            <Path Classes="icon" Data="M 4,12 A 8,8 0 1 1 12,20 M 4,12 L 4,7 M 4,12 L 9,12 M 12,8 L 12,12 L 15,14" />
            <TextBlock Classes="toollabel" Text="Restore" />
          </StackPanel>
        </Button>

        <!-- A new disk: the stack of platters with a plus beside it. -->
        <Button Classes="tool" Command="{Binding CreateDiskCommand}"
                ToolTip.Tip="Make a new hard disk image, formatted and ready, and attach it">
          <StackPanel>
            <Path Classes="icon" Data="M 3,7 A 6,3 0 1 0 15,7 A 6,3 0 1 0 3,7 M 3,7 L 3,15 A 6,3 0 0 0 15,15 L 15,7 M 19,9 L 19,17 M 15,13 L 23,13" />
            <TextBlock Classes="toollabel" Text="New disk" />
          </StackPanel>
        </Button>

        <!-- Eject: the triangle-over-bar found on every optical drive. -->
        <Button Classes="tool" ToolTip.Tip="Take out a floppy or the disc">
          <StackPanel>
            <Path Classes="icon filled" Data="M 12,4 L 20,14 L 4,14 Z M 4,17 L 20,17 L 20,20 L 4,20 Z" />
            <TextBlock Classes="toollabel" Text="Eject ▾" />
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="Floppy A:" Command="{Binding EjectFloppyACommand}" />
              <MenuItem Header="Floppy B:" Command="{Binding EjectFloppyBCommand}" />
              <MenuItem Header="CD-ROM" Command="{Binding EjectCompactDiscCommand}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <Separator Classes="vertical" />

        <!-- A mouse seen from above: the body, and the split between the two
             buttons. Which port it is plugged into is the guest's business,
             not a preference, so the choices are exclusive and shown ticked. -->
        <Button Classes="tool"
                ToolTip.Tip="Which port the mouse is plugged into. Software of the period looks for one specific port, so this decides whether a given program finds a mouse at all.">
          <StackPanel>
            <Path Classes="icon" Data="M 12,3 A 6,6 0 0 1 18,9 L 18,15 A 6,6 0 0 1 6,15 L 6,9 A 6,6 0 0 1 12,3 Z M 12,3 L 12,10 M 6,10 L 18,10" />
            <TextBlock Classes="toollabel" Text="Mouse ▾" />
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="PS/2 port" ToggleType="Radio"
                        IsChecked="{Binding MouseIsPs2, Mode=TwoWay}" />
              <MenuItem Header="Serial, on COM1" ToggleType="Radio"
                        IsChecked="{Binding MouseIsSerial, Mode=TwoWay}" />
              <MenuItem Header="No mouse" ToggleType="Radio"
                        IsChecked="{Binding MouseIsDisconnected, Mode=TwoWay}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <Separator Classes="vertical" />

        <!-- A chip seen from above: the package, and the legs down both
             sides. Unlike the mouse this cannot be changed under a running
             guest, so the choice takes effect at the next reset. -->
        <Button Classes="tool"
                ToolTip.Tip="Which processor is fitted. A program asks once, at startup, so the choice takes effect at the next reset.">
          <StackPanel>
            <Path Classes="icon" Data="M 7,7 L 17,7 L 17,17 L 7,17 Z M 4,10 L 7,10 M 4,14 L 7,14 M 17,10 L 20,10 M 17,14 L 20,14 M 10,4 L 10,7 M 14,4 L 14,7 M 10,17 L 10,20 M 14,17 L 14,20" />
            <TextBlock Classes="toollabel" Text="CPU ▾" />
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="486DX" ToggleType="Radio"
                        IsChecked="{Binding CpuIs486, Mode=TwoWay}" />
              <MenuItem Header="386DX" ToggleType="Radio"
                        IsChecked="{Binding CpuIs386, Mode=TwoWay}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <Separator Classes="vertical" />

        <!-- A screen with a magnifier: what is actually in video memory,
             which is not always what the monitor shows. -->
        <Button Classes="tool" Command="{Binding OpenVideoInspectorCommand}"
                ToolTip.Tip="Video memory: the card's registers and a picture of what the guest has written, which is not always what the monitor shows.">
          <StackPanel>
            <Path Classes="icon" Data="M 3,4 L 21,4 L 21,15 L 3,15 Z M 9,19 L 15,19 M 12,15 L 12,19 M 8,8 A 3,3 0 1 0 14,8 A 3,3 0 1 0 8,8 M 13,10 L 16,13" />
            <TextBlock Classes="toollabel" Text="Video" />
          </StackPanel>
        </Button>

        <!-- A bug, for the debugger: body, legs and antennae. -->
        <Button Classes="tool" Command="{Binding OpenDebuggerCommand}"
                ToolTip.Tip="Open the debugger: registers, disassembly, memory, breakpoints">
          <StackPanel>
            <Path Classes="icon" Data="M 8,8 A 4,5 0 0 1 16,8 L 16,14 A 4,5 0 0 1 8,14 Z M 3,10 L 8,11 M 21,10 L 16,11 M 3,17 L 8,15 M 21,17 L 16,15 M 9,4 L 10,7 M 15,4 L 14,7" />
            <TextBlock Classes="toollabel" Text="Debugger" />
          </StackPanel>
        </Button>

        <!-- Step: a footfall onto the next stair. -->
        <Button Classes="tool" Command="{Binding StepInstructionCommand}"
                ToolTip.Tip="Execute a single instruction and stop">
          <StackPanel>
            <Path Classes="icon" Data="M 3,20 L 9,20 L 9,15 L 15,15 L 15,10 L 21,10 L 21,5 M 5,11 L 9,7 L 5,3" />
            <TextBlock Classes="toollabel" Text="Step" />
          </StackPanel>
        </Button>

        <Separator Classes="vertical" />

        <!-- A camera: body, lens and the bump of the viewfinder. -->
        <Button Classes="tool" Command="{Binding ScreenshotCommand}"
                ToolTip.Tip="Save a picture of the screen to the desktop">
          <StackPanel>
            <Path Classes="icon" Data="M 3,7 L 8,7 L 10,4 L 14,4 L 16,7 L 21,7 L 21,20 L 3,20 Z M 12,10 A 4,4 0 1 1 11.99,10 Z" />
            <TextBlock Classes="toollabel" Text="Screenshot" />
          </StackPanel>
        </Button>

      </StackPanel>
    </Border>

    <!-- ==================== status bar ==================== -->
    <Border DockPanel.Dock="Bottom" Background="#252525"
            BorderBrush="#3A3A3A" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="8,4">

        <!-- power -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5"
                    VerticalAlignment="Center">
          <Ellipse Classes="led power"
                   Classes.on="{Binding PowerLedOn}" />
          <TextBlock Classes="status" Text="Power" />
        </StackPanel>

        <Separator Grid.Column="1" Classes="vertical" />

        <!-- one light per attached drive -->
        <ItemsControl Grid.Column="2" ItemsSource="{Binding Drives}"
                      VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="14" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DriveIndicator">
              <StackPanel Orientation="Horizontal" Spacing="5"
                          VerticalAlignment="Center"
                          ToolTip.Tip="{Binding MediaName}">
                <Ellipse Classes="led activity"
                         Classes.on="{Binding IsActive}" />
                <TextBlock Classes="status" Text="{Binding Label}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- speed and message -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                      ToolTip.Tip="Network activity">
            <Ellipse Classes="led activity" Classes.on="{Binding NetworkLedOn}" />
            <TextBlock Classes="status" Text="NET" />
          </StackPanel>
          <!-- Shown only while the guest has the pointer. It is the only
               thing on screen that explains where the cursor went, so it is
               tinted rather than left to blend into the other messages. -->
          <TextBlock Classes="status captured"
                     Text="{Binding MouseCaptureText}"
                     IsVisible="{Binding MouseCaptured}" />
          <TextBlock Classes="status" Text="{Binding SpeedText}" />
          <TextBlock Classes="status" Text="{Binding StatusText}" />
        </StackPanel>

      </Grid>
    </Border>

    <!-- ==================== the emulated screen ==================== -->
    <!-- The control letterboxes the picture to 4:3 itself, so it can simply
         fill whatever space is left between the toolbar and the status bar. -->
    <ctl:ScreenView Name="Screen" Session="{Binding Session}" />

  </DockPanel>
</Window>
