<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Copying the framebuffer into the display bitmap is done through the
         locked pixel pointer: one memcpy-shaped loop per frame instead of a
         bounds-checked write per pixel. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- The tests drive the real window, so they need the few seams that exist
       only for them: swapping the platform's pointer lock for a fake, so a
       test run does not hide the cursor of whoever started it. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Aurora386.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aurora386.Core\Aurora386.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!-- Cross-platform audio output. The core renders samples into a buffer
         and knows nothing about the host; this is what carries them to the
         speakers on macOS, Windows and Linux alike. -->
    <PackageReference Include="OpenTK.Audio.OpenAL" Version="4.9.4" />
  </ItemGroup>
</Project>
